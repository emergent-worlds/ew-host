{
  "$ref": "#/definitions/studio-validation",
  "definitions": {
    "studio-validation": {
      "type": "object",
      "properties": {
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "state": {
                "type": "string",
                "enum": [
                  "pass",
                  "fail",
                  "unavailable"
                ]
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "id",
              "title",
              "state",
              "detail"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "state": {
                "type": "string",
                "enum": [
                  "pass",
                  "warn",
                  "unavailable"
                ]
              }
            },
            "required": [
              "id",
              "title",
              "detail",
              "state"
            ],
            "additionalProperties": false
          }
        },
        "run": {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "enum": [
                "pass",
                "fail",
                "unavailable"
              ]
            },
            "requestedTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "completedTicks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "initialTick": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "finalTick": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "required": [
            "state",
            "requestedTicks",
            "completedTicks",
            "initialTick",
            "finalTick",
            "detail"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "checks",
        "run"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

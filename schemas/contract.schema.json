{
  "$ref": "#/definitions/contract",
  "definitions": {
    "contract": {
      "type": "object",
      "properties": {
        "studioValidation": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "reads": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "required": [
            "module",
            "reads"
          ],
          "additionalProperties": false
        },
        "studioRender": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "reads": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "required": [
            "module",
            "reads"
          ],
          "additionalProperties": false
        },
        "studioScenario": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "reads": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "actions": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "advance",
                  "set_variable"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "module",
            "reads",
            "actions"
          ],
          "additionalProperties": false
        },
        "needs": {
          "type": "object",
          "properties": {
            "calls": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "load",
                  "save",
                  "advance",
                  "input",
                  "read",
                  "query",
                  "explain",
                  "forecast",
                  "change"
                ]
              },
              "default": []
            },
            "state": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "adds": {
          "type": "object",
          "properties": {
            "slots": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "dashboard-line",
                  "variable-course",
                  "portrait",
                  "icon",
                  "map-view",
                  "graph-view",
                  "settings-section",
                  "scene-picture",
                  "artifact-item"
                ]
              },
              "default": []
            },
            "gives": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "dashboard-line",
                  "variable-course",
                  "portrait",
                  "icon",
                  "map-view",
                  "graph-view",
                  "settings-section",
                  "scene-picture",
                  "artifact-item"
                ]
              },
              "default": []
            }
          },
          "additionalProperties": false,
          "default": {}
        },
        "fits": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "recommends": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "default": {}
        },
        "keeps": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "description": {
                "type": "string",
                "maxLength": 500
              }
            },
            "required": [
              "prefix",
              "description"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

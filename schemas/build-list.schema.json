{
  "$ref": "#/definitions/build-list",
  "definitions": {
    "build-list": {
      "type": "object",
      "properties": {
        "domain": {
          "type": "string",
          "const": "ew.build-files.v1"
        },
        "folder": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "target": {
          "type": "string",
          "enum": [
            "windows-x64",
            "macos-arm64",
            "macos-x64",
            "linux-x64",
            "server"
          ]
        },
        "prefix": {
          "type": "string"
        },
        "entry": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "executable": {
                "type": "boolean"
              }
            },
            "required": [
              "path",
              "sha256",
              "size",
              "executable"
            ],
            "additionalProperties": false
          },
          "minItems": 1,
          "maxItems": 10000
        }
      },
      "required": [
        "domain",
        "folder",
        "version",
        "target",
        "prefix",
        "entry",
        "files"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

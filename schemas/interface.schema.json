{
  "$ref": "#/definitions/interface",
  "definitions": {
    "interface": {
      "type": "object",
      "properties": {
        "calls": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "load",
              "save",
              "advance",
              "input",
              "read",
              "query",
              "explain",
              "forecast",
              "change"
            ]
          },
          "minItems": 1
        },
        "takes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "saves",
              "while_away",
              "players",
              "agent.read",
              "agent.change",
              "models"
            ]
          },
          "default": []
        },
        "opens": {
          "type": "string",
          "default": "*"
        },
        "forecasts": {
          "type": "boolean",
          "default": false
        },
        "module": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "parts": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "default": {}
        },
        "state": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,39}$"
          },
          "default": []
        },
        "saveInspection": {
          "type": "object",
          "properties": {
            "module": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          },
          "required": [
            "module",
            "files"
          ],
          "additionalProperties": false
        },
        "format": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "default": 1
        }
      },
      "required": [
        "calls"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

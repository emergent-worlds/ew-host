{
  "name": "@emergent-worlds/host",
  "version": "0.3.7",
  "description": "The host contract of Emergent Worlds: the manifest, interface, and contract schemas, the message vocabulary between a folder and its host, the resolver of uses, and the compatibility marks.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "import": "./dist/loader.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./port": {
      "types": "./dist/port.d.ts",
      "import": "./dist/port.js"
    },
    "./journeys": {
      "types": "./dist/journeys.d.ts",
      "import": "./dist/journeys.js"
    }
  },
  "files": [
    "dist",
    "schemas"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/emit-schemas.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check:worker": "pnpm build && node scripts/worker-check.mjs",
    "check:runtime-workers": "node scripts/check-runtime-worker.mjs && bun scripts/check-runtime-worker.mjs",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "semver": "^7.6.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/semver": "^7.5.8",
    "jsdom": "25.0.1",
    "playwright": "1.64.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "zod-to-json-schema": "^3.24.0"
  },
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=24"
  }
}
